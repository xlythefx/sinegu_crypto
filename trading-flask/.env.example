# BINANCE_ABCD engine — copy to .env and fill in the secrets.
# Every key is optional unless marked REQUIRED; defaults shown.

# --- Service ------------------------------------------------------------------
BINANCE_ABCD_FLASK_PORT=5010
# REQUIRED - TradingView webhook shared secret (long random string)
BINANCE_ABCD_WEBHOOK_SECRET=

# --- sinegutrade-api ----------------------------------------------------------
# Local dev: php artisan serve. On the VPS the API is same-host.
BINANCE_ABCD_ENGINE_API_BASE=http://127.0.0.1:8000/api
# REQUIRED - must match ENGINE_SECRET in sinegutrade-api/.env
BINANCE_ABCD_ENGINE_SECRET=
BINANCE_ABCD_ENGINE_API_TIMEOUT=10

# --- Exchanges ----------------------------------------------------------------
# CSV of the venues this process trades and polls: binance, mexc, bybit.
# `binance` alone leaves every code path exactly as it was before MEXC existed;
# add a name to switch that venue on. NOT mirrored to prod by the deploy script
# — enabling a venue there is a decision made on the box.
BINANCE_ABCD_EXCHANGES=binance

# --- Binance futures ----------------------------------------------------------
BINANCE_ABCD_BINANCE_API_BASE=https://fapi.binance.com
# demo=1 accounts route here (Binance futures testnet)
BINANCE_ABCD_TESTNET_API_BASE=https://demo-fapi.binance.com
BINANCE_ABCD_API_TIMEOUT=15

# --- MEXC USDT-M futures ------------------------------------------------------
BINANCE_ABCD_MEXC_API_BASE=https://api.mexc.com
# demo=1 accounts route here (MEXC futures testnet: same login + same API keys
# as live, 10,000 test USDT). It sits behind a CDN and refuses IP-BOUND keys,
# so a demo key is created without "Link IP address".
BINANCE_ABCD_MEXC_TESTNET_API_BASE=https://futures.testnet.mexc.com
# Seconds of clock skew MEXC tolerates on Request-Time (server default 10, max 60).
BINANCE_ABCD_MEXC_RECV_WINDOW=20
# Margin mode for NEW positions: 1 isolated, 2 cross (a stacked entry reuses
# the existing position's own mode and leverage).
BINANCE_ABCD_MEXC_OPEN_TYPE=1
# MEXC requires leverage on every opening order: the signal's value wins, then
# the account's own setting for the contract, then this. 0 = refuse the entry.
BINANCE_ABCD_MEXC_DEFAULT_LEVERAGE=0
BINANCE_ABCD_MEXC_CONTRACTS_CACHE_TTL=3600
BINANCE_ABCD_MEXC_FAIR_PRICE_CACHE_TTL=15
# Closed trades + fee receipts for MEXC accounts (the MEXC twin of
# PAST_POSITIONS_FETCH_INTERVAL below).
BINANCE_ABCD_MEXC_HISTORY_FETCH_INTERVAL=180

# --- Bybit USDT perpetuals (V5, category=linear, accountType=UNIFIED) ---------
BINANCE_ABCD_BYBIT_API_BASE=https://api.bybit.com
# demo=1 accounts route here. This is Bybit's DEMO TRADING host, NOT
# api-testnet.bybit.com: demo is reached from the ordinary bybit.com login but
# its keys are minted in the Demo Trading module, so a live key is refused here
# and a demo key is refused on the live host. Top up with
# POST /v5/account/demo-apply-money. testnet.bybit.com is a different site with
# its own registration — do not paste a key from there.
BINANCE_ABCD_BYBIT_DEMO_API_BASE=https://api-demo.bybit.com
# Clock skew Bybit tolerates, in MILLISECONDS (its default is 5000). NOT the
# same unit as MEXC_RECV_WINDOW above, which is SECONDS — 20 here would ask for
# a 20 ms window and fail every call.
BINANCE_ABCD_BYBIT_RECV_WINDOW_MS=5000
BINANCE_ABCD_BYBIT_INSTRUMENTS_CACHE_TTL=3600
# Closed trades + fee receipts for Bybit accounts.
BINANCE_ABCD_BYBIT_HISTORY_FETCH_INTERVAL=180

# hedge | oneway
BINANCE_ABCD_POSITION_MODE=hedge
BINANCE_ABCD_SYNC_POSITION_MODE_ON_STARTUP=true
BINANCE_ABCD_POSITION_MODE_CACHE_TTL=21600

# --- Concurrency (fast-ACK queue + workers) -----------------------------------
BINANCE_ABCD_DISPATCH_WORKERS=8
BINANCE_ABCD_FANOUT_WORKERS=32
BINANCE_ABCD_HTTP_POOL_MAXSIZE=64
BINANCE_ABCD_WAITRESS_THREADS=16
# Post-close bookkeeping pool, kept separate from the fan-out pool because the
# fill-summary retry sleeps and must never hold up the next signal's orders.
BINANCE_ABCD_BOOKKEEPING_WORKERS=16

# --- Caches (seconds) ---------------------------------------------------------
BINANCE_ABCD_ACCOUNTS_CACHE_TTL=90
BINANCE_ABCD_ASSETS_CACHE_TTL=90
BINANCE_ABCD_LEVERAGE_CACHE_TTL=86400

# --- Pollers ------------------------------------------------------------------
# Set false in dev to run the webhook alone.
BINANCE_ABCD_RUN_POLLERS=true
BINANCE_ABCD_BALANCES_FETCH_INTERVAL=300
BINANCE_ABCD_POSITIONS_FETCH_INTERVAL=300
BINANCE_ABCD_TRANSFERS_FETCH_INTERVAL=600
BINANCE_ABCD_TRANSFERS_LOOKBACK_DAYS=3
# /fapi/v1/income costs weight 30 where every other poller call costs 5, so this
# one loop is ~95% of the engine's Binance budget (2400/min per IP) and decides
# how many accounts fit. It only feeds the backfill safety net — nothing
# time-critical waits on it, so slower is nearly free. Was 60.
BINANCE_ABCD_PAST_POSITIONS_FETCH_INTERVAL=180
BINANCE_ABCD_INCOME_LOOKBACK_HOURS=24
# First-run seed for the fee-receipts ledger (commission + funding per fill,
# shipped to /engine/binance/fees off the same income call). 7 days catches the
# entry fills of positions still open at deploy; userTrades goes no further back.
BINANCE_ABCD_FEES_LOOKBACK_HOURS=168
BINANCE_ABCD_PAST_POSITIONS_INDEXING_LAG_SECONDS=120
# Seconds between each poller's first tick, so they don't all fire at once.
BINANCE_ABCD_POLLER_START_STAGGER_SECONDS=7

# --- Fill summary (realized PnL read after a close) ---------------------------
# Binance's userTrades index trails the fill, so the first read after a close is
# often empty — without a retry the close message ships with no PnL line. Keep
# attempts x retry seconds under TELEGRAM_PNL_WAIT_SECONDS below.
BINANCE_ABCD_FILL_SUMMARY_ATTEMPTS=3
BINANCE_ABCD_FILL_SUMMARY_RETRY_SECONDS=2

# --- Retry queue --------------------------------------------------------------
BINANCE_ABCD_RETRY_ENABLED=true
BINANCE_ABCD_RETRY_INTERVAL_SECONDS=60
BINANCE_ABCD_RETRY_MAX_ATTEMPTS=5

# --- Exit retry (in-call, before the queue) -----------------------------------
# A close that failed transiently (408/-1007 "execution status unknown", 5xx,
# timeout) is re-attempted inside the fan-out worker instead of waiting a full
# RETRY_INTERVAL_SECONDS. Every attempt re-reads the position first, so an
# unconfirmed order that did land closes nothing twice. The worker sleeps for
# the backoff — keep the budget small.
BINANCE_ABCD_EXIT_RETRY_ATTEMPTS=2
BINANCE_ABCD_EXIT_RETRY_SECONDS=1.5

# --- Telegram notifications ---------------------------------------------------
# Off unless BOTH a token and a chat id are set. Entries, exits + realized PnL
# go to CHAT_ID; rejected signals / account failures / poller crashes go to
# ADMIN_CHAT_ID (falls back to CHAT_ID when empty).
BINANCE_ABCD_TELEGRAM_ENABLED=true
BINANCE_ABCD_TELEGRAM_BOT_TOKEN=
# Numeric channel id (-100...) or @channelname
BINANCE_ABCD_TELEGRAM_CHAT_ID=
BINANCE_ABCD_TELEGRAM_ADMIN_CHAT_ID=
# Seconds an exit message waits for every closed account's realized PnL
BINANCE_ABCD_TELEGRAM_PNL_WAIT_SECONDS=25

# --- Discord mirror (public messages only) ------------------------------------
# The PUBLIC messages (entries, exits + PnL percent, recaps) are also posted to
# a Discord channel as coloured embeds. Admin alerts are NEVER mirrored — no
# admin webhook, no fallback. Independent of Telegram; off while the URL is
# empty. The URL contains the webhook token (anyone holding it can post to the
# channel): keep it in .env only. Create it in Discord under
# Server Settings -> Integrations -> Webhooks; name/avatar are set there.
BINANCE_ABCD_DISCORD_ENABLED=true
BINANCE_ABCD_DISCORD_WEBHOOK_URL=
# The "wins" channel: a positive DAILY recap is also posted here, per venue, as
# an image card. Nothing else is sent to it. Empty = off. Also a secret.
BINANCE_ABCD_DISCORD_WINS_WEBHOOK_URL=

# --- Scheduled performance reports (public channel) ---------------------------
# Daily / weekly / monthly recaps built from GET /api/public/track-record — the
# same endpoint the landing page reads, so the channel can only ever publish
# percentages and trade counts, and can never disagree with the website.
# Times are LOCAL to REPORT_TIMEZONE. Empty value = that report is off.
#   DAILY_AT    HH:MM                  MONTHLY_AT  <last|1-28> HH:MM
#   WEEKLY_AT   <mon..sun> HH:MM
# Every recap covers a window ending TODAY (the local day it fires in): the
# daily is today, the weekly the 7 days ending today, the monthly the 1st to
# today. Days are cut in the calendar the API buckets the track record in
# (TRACK_RECORD_TIMEZONE on the API, Asia/Manila on prod) — keep this timezone
# the same as that one. Trades closing AFTER the firing time show on the site
# and in the weekly/monthly, but no daily names them, so fire late in the day;
# the past-positions backfill (~3 min) and the API's 5-min cache make 23:55
# about the latest honest time.
BINANCE_ABCD_REPORT_ENABLED=true
BINANCE_ABCD_REPORT_TIMEZONE=Asia/Manila
BINANCE_ABCD_REPORT_DAILY_AT=23:55
BINANCE_ABCD_REPORT_WEEKLY_AT=fri 23:55
# 'last' = the whole calendar month; '<1-28>' = month-to-date on that day.
BINANCE_ABCD_REPORT_MONTHLY_AT=last 23:55
# A recap missed while the engine was down is still posted when it returns, but
# only within this many hours. Past that the period is marked done and skipped.
BINANCE_ABCD_REPORT_CATCHUP_HOURS=12
BINANCE_ABCD_REPORT_TICK_SECONDS=30

# --- Sizing -------------------------------------------------------------------
# Balance that earns exactly one base_size. Below it every account still gets
# one base_size; above it size scales in whole steps (coarse tickers) or tenths.
BINANCE_ABCD_REFERENCE_BALANCE=1000
BINANCE_ABCD_COARSE_STEP_TICKERS=BTCUSDT
# Minimum TOTAL DEPOSITED capital (net of withdrawals) an account needs before
# it may open a position. Gated on deposit, not balance, so a funded account
# keeps trading through a drawdown. Unknown deposit = blocked. 0 disables.
# Exits are never gated — an open position must always be closable.
BINANCE_ABCD_MIN_DEPOSIT=1000

# --- Reserved for horizontal scaling (not implemented yet) --------------------
# BINANCE_ABCD_SHARD_INDEX=0
# BINANCE_ABCD_SHARD_COUNT=1
