BINANCE_WEBHOOK_SECRET=
MEXC_WEBHOOK_SECRET=

BINANCE_FLASK_PORT=5000
BINANCE_LITE_FLASK_PORT=5003
MEXC_FLASK_PORT=5001
# BINANCE_LITE_WEBHOOK_SECRET defaults to BINANCE_WEBHOOK_SECRET when unset.
#BINANCE_LITE_WEBHOOK_SECRET=

BINANCE_ACCOUNT_LISTENER_PORT=6000
MEXC_ACCOUNT_LISTENER_PORT=6001

BINANCE_API_BASE=https://fapi.binance.com
BINANCE_API_TIMEOUT=15
BINANCE_POSITION_MODE=hedge
BINANCE_SYNC_POSITION_MODE_ON_STARTUP=true
BINANCE_LIVE_QUANTITY=0.01
BINANCE_LOG_INTERVAL=10
BINANCE_POSITIONS_FETCH_INTERVAL=10
BINANCE_TRANSFERS_FETCH_INTERVAL=10
BINANCE_BALANCES_FETCH_INTERVAL=10
BINANCE_TRANSFERS_LOOKBACK_DAYS=3
#BINANCE_API_BASE_URL=http://localhost/trading-api/public
BINANCE_API_BASE_URL=https://api.flowehn.com
BINANCE_ASSETS_ENDPOINT=/api/flask/assets
BINANCE_ASSETS_BROKER=Binance
BINANCE_ACCOUNTS_ENDPOINT=/api/flask/binance-accounts
BINANCE_INSERT_POSITIONS_ENDPOINT=/api/flask/positions
BINANCE_INSERT_PAST_POSITION_ENDPOINT=/api/flask/past-position
BINANCE_SYNC_PAST_POSITIONS_ENDPOINT=/api/flask/sync-past-positions
BINANCE_INSERT_TRANSACTIONS_ENDPOINT=/api/flask/transactions
BINANCE_UPDATE_BALANCE_ENDPOINT=/api/flask/balance
BINANCE_PAST_POSITIONS_FETCH_INTERVAL=60
BINANCE_INCOME_LOOKBACK_HOURS=24

MEXC_API_BASE=https://api.mexc.com
MEXC_API_TIMEOUT=15
MEXC_OPEN_TYPE=1
MEXC_LEVERAGE=5
MEXC_POSITION_MODE=2
MEXC_LIVE_QUANTITY=1
MEXC_LOG_INTERVAL=10
MEXC_BALANCES_FETCH_INTERVAL=10
MEXC_POSITIONS_FETCH_INTERVAL=10
#MEXC_API_BASE_URL=http://localhost/trading-api/public
MEXC_API_BASE_URL=https://api.flowehn.com
MEXC_ASSETS_ENDPOINT=/api/flask/assets
MEXC_ACCOUNTS_ENDPOINT=/api/flask/mexc-accounts
MEXC_INSERT_POSITIONS_ENDPOINT=/api/flask/mexc-positions
MEXC_INSERT_PAST_POSITION_ENDPOINT=/api/flask/mexc-past-position
MEXC_UPDATE_BALANCE_ENDPOINT=/api/flask/balance

BYBIT_WEBHOOK_SECRET=
BYBIT_FLASK_PORT=5002
BYBIT_ACCOUNT_LISTENER_PORT=6002
BYBIT_API_BASE=https://api.bybit.com
BYBIT_API_TIMEOUT=15
BYBIT_POSITION_MODE=hedge
BYBIT_WARN_POSITION_MODE_MISMATCH=true
BYBIT_LIVE_QUANTITY=0.01
BYBIT_DEFAULT_LEVERAGE=10
BYBIT_LOG_INTERVAL=10
BYBIT_BALANCES_FETCH_INTERVAL=10
# BYBIT_API_BASE_URL=http://localhost/trading-api/public
BYBIT_API_BASE_URL=https://api.flowehn.com
BYBIT_ASSETS_ENDPOINT=/api/flask/assets
BYBIT_ACCOUNTS_ENDPOINT=/api/flask/bybit-accounts
BYBIT_INSERT_POSITIONS_ENDPOINT=/api/flask/bybit-positions
BYBIT_INSERT_PAST_POSITION_ENDPOINT=/api/flask/bybit-past-position
BYBIT_UPDATE_BALANCE_ENDPOINT=/api/flask/balance

# Auth used by Flask -> Laravel trading-api (/api/flask/*).
# Leave empty to use per-bot defaults (binance_bot / mexc_bot / bybit_bot).
TRADING_API_WEBHOOK_SECRET=
# Optional if Laravel later also validates bearer tokens.
TRADING_API_BEARER_TOKEN=
