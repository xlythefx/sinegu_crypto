# BINANCE_ABCD engine — copy to .env and fill in the secrets.
# Every key is optional unless marked REQUIRED; defaults shown.

# --- Service ------------------------------------------------------------------
BINANCE_ABCD_FLASK_PORT=5010
# REQUIRED - TradingView webhook shared secret (long random string)
BINANCE_ABCD_WEBHOOK_SECRET=

# --- sinegutrade-api ----------------------------------------------------------
# Local dev: php artisan serve. On the VPS the API is same-host.
BINANCE_ABCD_ENGINE_API_BASE=http://127.0.0.1:8000/api
# REQUIRED - must match ENGINE_SECRET in sinegutrade-api/.env
BINANCE_ABCD_ENGINE_SECRET=
BINANCE_ABCD_ENGINE_API_TIMEOUT=10

# --- Binance futures ----------------------------------------------------------
BINANCE_ABCD_BINANCE_API_BASE=https://fapi.binance.com
# demo=1 accounts route here (Binance futures testnet)
BINANCE_ABCD_TESTNET_API_BASE=https://demo-fapi.binance.com
BINANCE_ABCD_API_TIMEOUT=15
# hedge | oneway
BINANCE_ABCD_POSITION_MODE=hedge
BINANCE_ABCD_SYNC_POSITION_MODE_ON_STARTUP=true
BINANCE_ABCD_POSITION_MODE_CACHE_TTL=21600

# --- Concurrency (fast-ACK queue + workers) -----------------------------------
BINANCE_ABCD_DISPATCH_WORKERS=8
BINANCE_ABCD_FANOUT_WORKERS=32
BINANCE_ABCD_HTTP_POOL_MAXSIZE=64
BINANCE_ABCD_WAITRESS_THREADS=16

# --- Caches (seconds) ---------------------------------------------------------
BINANCE_ABCD_ACCOUNTS_CACHE_TTL=90
BINANCE_ABCD_ASSETS_CACHE_TTL=90
BINANCE_ABCD_LEVERAGE_CACHE_TTL=86400

# --- Pollers ------------------------------------------------------------------
# Set false in dev to run the webhook alone.
BINANCE_ABCD_RUN_POLLERS=true
BINANCE_ABCD_BALANCES_FETCH_INTERVAL=300
BINANCE_ABCD_POSITIONS_FETCH_INTERVAL=300
BINANCE_ABCD_TRANSFERS_FETCH_INTERVAL=600
BINANCE_ABCD_TRANSFERS_LOOKBACK_DAYS=3
BINANCE_ABCD_PAST_POSITIONS_FETCH_INTERVAL=60
BINANCE_ABCD_INCOME_LOOKBACK_HOURS=24
BINANCE_ABCD_PAST_POSITIONS_INDEXING_LAG_SECONDS=120

# --- Retry queue --------------------------------------------------------------
BINANCE_ABCD_RETRY_ENABLED=true
BINANCE_ABCD_RETRY_INTERVAL_SECONDS=60
BINANCE_ABCD_RETRY_MAX_ATTEMPTS=5

# --- Telegram notifications ---------------------------------------------------
# Off unless BOTH a token and a chat id are set. Entries, exits + realized PnL
# go to CHAT_ID; rejected signals / account failures / poller crashes go to
# ADMIN_CHAT_ID (falls back to CHAT_ID when empty).
BINANCE_ABCD_TELEGRAM_ENABLED=true
BINANCE_ABCD_TELEGRAM_BOT_TOKEN=
# Numeric channel id (-100...) or @channelname
BINANCE_ABCD_TELEGRAM_CHAT_ID=
BINANCE_ABCD_TELEGRAM_ADMIN_CHAT_ID=
# Seconds an exit message waits for every closed account's realized PnL
BINANCE_ABCD_TELEGRAM_PNL_WAIT_SECONDS=25

# --- Sizing -------------------------------------------------------------------
# Balance that earns exactly one base_size. Below it every account still gets
# one base_size; above it size scales in whole steps (coarse tickers) or tenths.
BINANCE_ABCD_REFERENCE_BALANCE=1000
BINANCE_ABCD_COARSE_STEP_TICKERS=BTCUSDT
# Minimum TOTAL DEPOSITED capital (net of withdrawals) an account needs before
# it may open a position. Gated on deposit, not balance, so a funded account
# keeps trading through a drawdown. Unknown deposit = blocked. 0 disables.
# Exits are never gated — an open position must always be closable.
BINANCE_ABCD_MIN_DEPOSIT=1000

# --- Reserved for horizontal scaling (not implemented yet) --------------------
# BINANCE_ABCD_SHARD_INDEX=0
# BINANCE_ABCD_SHARD_COUNT=1
