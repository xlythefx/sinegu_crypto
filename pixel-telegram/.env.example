# pixel-telegram — copy to .env and fill in. .env is gitignored: this repo is
# public on GitHub, so the bot token must never appear in a committed file.

# --- Telegram -----------------------------------------------------------------
# Off unless BOTH a token and a chat id are set.
PIXEL_TG_ENABLED=true
# The same bot that posts to the public channel (see trading-flask/.env).
PIXEL_TG_BOT_TOKEN=
# The "Pixel Alpha Admin Control" group. Get it with:
#   python -m pixel_telegram.main chat-id
# A supergroup id is negative and starts -100.
PIXEL_TG_CHAT_ID=

# --- What this box is called in the message -----------------------------------
PIXEL_TG_VPS_NAME=Pixel Alpha VPS

# --- Services watched for restarts / outages ----------------------------------
# Comma-separated `unit=Label` pairs. The UNIT is the address systemctl resolves
# (renaming `sinegualerts-engine` on the box would break the deploy script, the
# sudoers rule and the journal reads); the LABEL is what a person reads in the
# group. Drop the `=Label` half and the unit name is shown as-is.
# php-fpm carries the PHP version in its name — confirm it on the box with:
#   systemctl list-units 'php*-fpm*'
PIXEL_TG_UNITS=sinegualerts-engine=Pixel Alpha engine,nginx=Web server (nginx),php8.3-fpm=API runtime (php-fpm)

# The engine's health endpoint, read best-effort for the report footer.
PIXEL_TG_ENGINE_HEALTH_URL=http://127.0.0.1:5010/health

# --- Resource thresholds (percent) --------------------------------------------
PIXEL_TG_DISK_PATH=/
PIXEL_TG_CPU_ALERT_PERCENT=95
PIXEL_TG_RAM_ALERT_PERCENT=90
PIXEL_TG_DISK_ALERT_PERCENT=90
# One alert per metric per this many minutes.
PIXEL_TG_ALERT_COOLDOWN_MINUTES=60

# --- State --------------------------------------------------------------------
# Last-seen unit states + last-alert times. Defaults to pixel-telegram/state/state.json.
#PIXEL_TG_STATE_FILE=
