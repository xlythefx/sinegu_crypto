# Base URL of the sinegutrade-api (Laravel). Local dev: php artisan serve
VITE_API_URL=http://127.0.0.1:8000/api

# THE FLIP: 1 = `npm run dev` talks to the LIVE production API and database
# (real users, real invoices, real exchange accounts — writes are real too).
# 0 or unset = the local WAMP API above. Dev server only; a deployed build
# always uses its own origin and ignores this.
VITE_USE_PROD_API=0
VITE_PROD_API_URL=https://pixel-alpha.com/api
