# Pixel Alpha developer agent (dev-agent/agent.py). Copy to dev-agent/.env (gitignored).
# Never commit real values: this repo is public.

# The server it polls.
DEV_AGENT_API=https://pixel-alpha.com/api
# Must equal DEV_BOT_AGENT_KEY in the server's api/.env.
DEV_AGENT_KEY=
# A read-only AI connector key (pxa_…, Admin → AI Access) for live data. Optional.
DEV_AGENT_MCP_KEY=

# Optional:
#DEV_AGENT_MODEL=opus
#DEV_AGENT_POLL_SECONDS=10
#DEV_AGENT_CLAUDE_TIMEOUT=2700
#DEV_AGENT_WORKDIR=C:\Users\Xlythe\.devagent
#DEV_AGENT_WEB_REPO=C:\Users\Xlythe\sinegual-crypto
#DEV_AGENT_API_REPO=C:\wamp64\www\sinegutrade-api
